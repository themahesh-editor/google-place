# Documentation only: CLI does not automatically load .env files.
# Export these securely in your shell or configure the four GitHub Secrets.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
GOOGLE_PLACES_API_KEY=
LLM_API_KEY=
# JSON array of ten distinct accounts required for real sends.
# Repeat this shape with your real values and unique ids/emails, ten total.
# Use an app password if your provider requires one. Never commit this JSON.
# imap_password is optional; otherwise password is used for SMTP and IMAP.
SENDER_ACCOUNTS_JSON='[{"id":"sender01","email":"sender01@example.com","password":"REPLACE_LOCALLY","smtp_host":"smtp.example.com","smtp_port":465,"imap_host":"imap.example.com","imap_port":993,"tls_mode":"ssl"}]'
# Integration tests ONLY: use a disposable PostgreSQL database. Adjust authentication locally if needed; never use production.
TEST_DATABASE_URL=postgresql://attachai@localhost:5432/attachai_test
