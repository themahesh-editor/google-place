# Production secrets / identities. Put these in GitHub Secrets (passwords/API keys)
# and GitHub Variables (non-secret sender emails/host overrides).
SUPABASE_DB_URL=postgresql://postgres:YOUR_PASSWORD@db.YOURPROJECT.supabase.co:5432/postgres
NVIDIA_API_KEY=
GOOGLE_PLACES_API_KEY=

# Ten sender credentials; one secret per sender.
SENDER_1=
SENDER_2=
SENDER_3=
SENDER_4=
SENDER_5=
SENDER_6=
SENDER_7=
SENDER_8=
SENDER_9=
SENDER_10=

# Ten sender email identities; prefer GitHub Variables rather than Secrets.
SENDER_1_EMAIL=sender1@example.com
SENDER_2_EMAIL=sender2@example.com
SENDER_3_EMAIL=sender3@example.com
SENDER_4_EMAIL=sender4@example.com
SENDER_5_EMAIL=sender5@example.com
SENDER_6_EMAIL=sender6@example.com
SENDER_7_EMAIL=sender7@example.com
SENDER_8_EMAIL=sender8@example.com
SENDER_9_EMAIL=sender9@example.com
SENDER_10_EMAIL=sender10@example.com

# Optional per-sender SMTP/IMAP overrides.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USE_SSL=true
# Optional API/provider overrides.
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
